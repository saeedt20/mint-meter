#!/usr/bin/make -f

%:
	dh $@ --with python3

override_dh_auto_build:
	/usr/bin/python3 scripts/package.py --check-version

override_dh_auto_test:
	PYTHONPATH=src /usr/bin/python3 -m unittest discover -s tests -v

override_dh_auto_install:
	/usr/bin/python3 scripts/package.py --stage debian/tallydesklet

override_dh_python3:
	dh_python3 /usr/share/tallydesklet
