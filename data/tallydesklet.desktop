[Desktop Entry]
Version=1.0
Type=Application
Name=TallyDesklet
Comment=Compact desktop CPU, memory, storage and network monitor
Exec=tallydesklet
Icon=tallydesklet
Terminal=false
Categories=System;Monitor;
Keywords=CPU;RAM;disk;network;widget;
StartupNotify=false
Actions=Settings;Reset;Quit;

[Desktop Action Settings]
Name=Settings
Exec=tallydesklet --settings

[Desktop Action Reset]
Name=Reset Position
Exec=tallydesklet --reset-position

[Desktop Action Quit]
Name=Quit
Exec=tallydesklet --quit
